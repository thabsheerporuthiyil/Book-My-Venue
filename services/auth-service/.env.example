# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Set to 'config.settings.dev' for local development
# Set to 'config.settings.prod' for production environments
DJANGO_SETTINGS_MODULE=config.settings.dev

# Unique and secret key for this specific deployment.
# In production, set this to a long random string.
DJANGO_SECRET_KEY=unsafe-dev-secret-key-change-in-production

# Comma-separated list of host/domain names that this Django site can serve.
# Example: auth.bookmyvenue.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins that are authorized to make cross-site HTTP requests.
# Example: https://bookmyvenue.com,https://app.bookmyvenue.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Connection URL for PostgreSQL database. Format:
# postgres://user:password@host:port/database_name?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/auth_db

# =============================================================================
# INTERNAL SERVICE SECURITY
# =============================================================================
# Shared API key used for inter-service communications (internal API routes).
# Must match the API key configured in gateway and other microservices.
INTERNAL_SERVICE_API_KEY=dev-internal-api-key

# =============================================================================
# CACHE & BROKER CONFIGURATION
# =============================================================================
# Connection URL for Redis. Format: redis://host:port/db_index
REDIS_URL=redis://redis:6379/0
