# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.dev

DJANGO_SECRET_KEY=unsafe-dev-secret-key-change-in-production

ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Connection URL for PostgreSQL (Neon). Format:
# postgres://user:password@host:port/database_name?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/venue_db

# =============================================================================
# INTERNAL SERVICE SECURITY
# =============================================================================
INTERNAL_SERVICE_API_KEY=dev-internal-api-key

# Auth Service URL (used for cross-service JWT validation)
AUTH_SERVICE_URL=http://auth-service:8001

# =============================================================================
# CACHE & BROKER CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# STORAGE BACKEND
# =============================================================================
# Options:
#   apps.common.storage.cloudinary_backend.CloudinaryStorageBackend (default)
#   apps.common.storage.s3_backend.S3StorageBackend (future)
STORAGE_BACKEND=apps.common.storage.cloudinary_backend.CloudinaryStorageBackend

# =============================================================================
# CLOUDINARY CREDENTIALS
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
